{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://multilogin-labs.github.io/data/schemas/benchmark-v1.schema.json",
  "title": "multilogin-labs benchmark v1",
  "type": "object",
  "required": ["schema", "report_id", "methodology_version", "published"],
  "properties": {
    "schema": { "const": "multilogin-labs/benchmark/v1" },
    "report_id": { "type": "string", "pattern": "^\\d{4}-\\d{2}$" },
    "methodology_version": { "type": "string" },
    "published": { "type": "string", "format": "date" },
    "platforms_tested": { "type": "integer", "minimum": 1 },
    "summary": { "type": "object" },
    "bands": { "type": "array" },
    "platforms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "score", "band", "evidence_level"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "score": { "type": "number", "minimum": 0, "maximum": 10 },
          "band": { "enum": ["A", "B", "C"] },
          "evidence_level": { "enum": ["A", "B", "C"] },
          "blocker": { "type": "boolean" },
          "caveat": { "type": "string" }
        }
      }
    }
  }
}
